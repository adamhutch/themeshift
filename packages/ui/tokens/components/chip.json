    "chip": {
      "layout": {
        "gap": { "$value": "{space.1}" },
        "gapSmall": { "$value": "{space.1}" },
        "gapLarge": { "$value": "{space.2}" }
      },

      "size": {
        "small": {
          "height": { "$value": "{space.5}" },
          "paddingBlock": { "$value": "{space.1}" },
          "paddingInline": { "$value": "{space.2}" }
        },

        "medium": {
          "height": { "$value": "{space.6}" },
          "paddingBlock": { "$value": "{space.1}" },
          "paddingInline": { "$value": "{space.2}" }
        },

        "large": {
          "height": { "$value": "{space.7}" },
          "paddingBlock": { "$value": "{space.1}" },
          "paddingInline": { "$value": "{space.3}" }
        }
      },

      "radius": {
        "none": { "$value": "0px" },
        "full": { "$value": "{radius.xLarge}" },
        "large": { "$value": "{radius.small}" },
        "medium": { "$value": "{radius.xSmall}" }
      },

      "avatar": {
        "size": { "$value": "{space.4}" },
